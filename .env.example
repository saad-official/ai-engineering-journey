# Copy to .env (gitignored) or use scripts/add-secret.ps1 to fill it in.
# Never commit real values. Never send private/company data through free tiers.

# Primary provider: Google Gemini (AI Studio) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Secondary: Groq - https://console.groq.com/keys
GROQ_API_KEY=
# Model zoo: OpenRouter - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Local models (no secret; Ollama ignores the key but the OpenAI client requires one)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Filled in later phases
# VOYAGE_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# DATABASE_URL=
